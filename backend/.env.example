# Goonj backend — copy to .env and fill in
PORT=4000
DATABASE_URL=postgres://goonj:goonj@localhost:5432/goonj
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
JWT_EXPIRY=30d

# Media storage. `local` keeps files on disk (no credentials); `s3` targets an
# S3-compatible bucket and needs the credentials below (not implemented yet).
MEDIA_PROVIDER=local
MEDIA_DIR=.media
MEDIA_SIGNING_SECRET=change-me-in-production
MEDIA_URL_TTL=3600
S3_BUCKET=goonj-media-dev
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_URL_TTL=900

# AI dubbing (Phase 1)
ASR_PROVIDER=
TRANSLATE_PROVIDER=
VOICE_CLONE_PROVIDER=

# Payments (Phase 2)
PAYMENTS_PROVIDER=

# Dubbing service (Phase 1)
DUBBING_URL=http://localhost:4100
PAYMENTS_URL=http://localhost:4200
LIVE_URL=http://localhost:4300
COMMUNITY_URL=http://localhost:4400
